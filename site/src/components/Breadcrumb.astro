---
interface Props { trail: { name: string; href?: string }[] }
const { trail } = Astro.props;
---
<nav class="bc" aria-label="Você está aqui">
  <ol>
    {trail.map((t, i) => (
      <li>{t.href && i < trail.length - 1 ? <a href={t.href}>{t.name}</a> : <span aria-current="page">{t.name}</span>}</li>
    ))}
  </ol>
</nav>
