---
import Logo from './Logo.astro';
import { whatsappUrl } from '../data/site';

const links = [
  ['#posicionamento', 'Tese'],
  ['#escada', 'Escada'],
  ['#ciclo', 'O método'],
  ['#entregas', 'Entregas'],
  ['#linha', 'Linha do tempo'],
  ['#papeis', 'Papéis'],
  ['#investimento', 'Investimento'],
];
---
<header class="hd">
  <div class="wrap hd-in">
    <a class="hd-mark" href="#topo" aria-label="CR CODE, voltar ao topo">
      <Logo /><span translate="no" style="color:inherit">CR <span>CODE</span></span>
    </a>
    <nav class="hd-nav" aria-label="Seções">
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="btn btn-primary hd-cta" href={whatsappUrl} target="_blank" rel="noopener" data-track="whatsapp_click" data-where="header">Conversar</a>
  </div>
</header>
