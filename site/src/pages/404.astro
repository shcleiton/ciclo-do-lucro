    <div class="wrap doc-in">
      <h1>Página não encontrada</h1>
      <p class="lead">O endereço mudou ou não existe. Estes são os caminhos do site:</p>
      <ul class="doc-links">
        <li><a href={withBase('')}>O método Ciclo do Lucro</a></li>
