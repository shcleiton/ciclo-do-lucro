---
import { social } from '../data/site';
// TODO: Instagram, LinkedIn e e-mail em src/data/site.ts. Links vazios não aparecem.
const links = [
  social.instagram && { href: social.instagram, label: 'Instagram' },
  social.linkedin && { href: social.linkedin, label: 'LinkedIn' },
  social.email && { href: `mailto:${social.email}`, label: social.email },
].filter(Boolean) as { href: string; label: string }[];
---
<footer class="ft">
  <div class="wrap">
    <span><b>CR CODE</b> · Cleiton Ramos</span>
    <nav aria-label="Contato e informações">
      {links.map((l) => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">{l.label}</a>)}
      <a href="/privacidade">Política de privacidade</a>
    </nav>
  </div>
</footer>
