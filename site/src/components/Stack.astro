---
import { stack } from '../data/content';
// Ícones de linha, um traço só (1.7), na ordem das camadas.
const icons = [
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>',
  '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  '<path d="M9 3h8l4 4v11a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/><path d="M17 3v4h4M3 7v12a2 2 0 0 0 2 2h9"/>',
  '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="M2.5 10h19M6 15h4"/>',
  '<path d="M3 10v4h4l6 4V6L7 10H3z"/><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"/>',
  '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>',
  '<path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5z"/><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"/>',
  '<rect x="2.5" y="6" width="13" height="12" rx="2"/><path d="m15.5 10 6-3.5v11l-6-3.5"/>',
  '<path d="m2 9 10-5 10 5-10 5z"/><path d="M6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5M22 9v6"/>',
  '<ellipse cx="12" cy="5.5" rx="8" ry="3"/><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3"/>',
];
---
<section id="stack" class="paper" aria-labelledby="stack-h">
  <div class="wrap">
    <div class="head">
      <h2 id="stack-h">As camadas técnicas antes do primeiro anúncio.</h2>
      <p class="lead">Tudo isso precisa estar configurado e conversando entre si. Se o rastreamento falha aqui, o tráfego roda no escuro o lançamento inteiro. O especialista só libera acessos e aprova.</p>
    </div>
    <div class="stk-cols" aria-hidden="true"><span>Camada</span><span>O que precisa existir</span><span>Por que importa</span></div>
    <ul class="stk-list">
      {stack.map(([name, what, why], i) => (
        <li class="stk-row">
          <span class="stk-nm">
            <span class="stk-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i]} /></span>
            <span>{name}</span>
          </span>
          <span class="stk-what"><span class="sr-only">O que precisa existir: </span>{what}</span>
          <span class="stk-why"><span class="sr-only">Por que importa: </span>{why}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
