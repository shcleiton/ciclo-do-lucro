---
import CycleRing from './CycleRing.astro';
---
<section id="topo" class="hero" aria-labelledby="topo-h">
  <div class="wrap">
    <h1 id="topo-h"><span class="hl"><span class="hl-in">Onde o creator</span></span> <span class="hl"><span class="hl-in">encontra campanha.</span></span></h1>
    <div class="hero-grid">
      <div class="hero-rise">
        <p class="lead">Proposta para a MO2 Influência. Transformar a história da MO2 em prova, criar o mapa da rede de creators e abrir o cadastro com critério.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#entregas">Ver as entregas</a>
          <a class="btn" href="#investimento">Ver o investimento</a>
        </div>
      </div>
      <CycleRing />
    </div>
    <dl class="facts hero-rise-2">
      <div><dt>Site com mapa</dt><dd>Cadastro e pedidos de marcas</dd></div>
      <div><dt>Conteúdo</dt><dd>12 roteiros e 4 carrosséis por mês</dd></div>
      <div><dt>Edição de vídeo</dt><dd>Sistema com IA em Beta</dd></div>
      <div><dt>Contrato</dt><dd>Mínimo de 6 meses</dd></div>
    </dl>
  </div>
</section>
